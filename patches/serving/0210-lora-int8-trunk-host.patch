+/* ---------------------------------------------------------------- the input basis (lora.h) */
+int parse_input_basis(const std::string& s, InputBasis* out, std::string* err) {
+    if (s.empty()) {
+        if (out) *out = kInputNatural;
+        return RAD_OK;
+    }
+    if (s == "fwht128") {
+        if (out) *out = kInputFwht128;
+        return RAD_OK;
+    }
+    return fail(err, RAD_E_UNSUPPORTED,
+                fmt("radiance_input_basis is '%s'; radiance serves no adapter whose A factors are "
+                    "stored in that basis (only 'fwht128')", s.c_str()));
+}
+
+bool trunk_transformed(const Program& prog) {
+    for (size_t h = 1; h < prog.weights.size(); ++h)
+        if (prog.weights[h].enc_known && prog.weights[h].enc.transform[0]) return true;
+    return false;
+}
