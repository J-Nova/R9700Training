+/* adapter_config.json's radiance_input_basis (lora::InputBasis, docs/ADAPTER.md §4): "" when the
+ * adapter declares no key. A value radiance serves no kernel for is refused here, naming it. */
+int read_input_basis(const std::string& name, const std::string& dir, std::string* out,
+                     std::string* err) {
+    const std::string path = dir + "/adapter_config.json";
+    std::ifstream f(path);
+    if (!f) { *err = "cannot read " + path; return RAD_E_NOTFOUND; }
+    nlohmann::json j;
+    try { f >> j; } catch (const std::exception& e) { *err = path + ": " + e.what(); return RAD_E_INVAL; }
+    const auto it = j.find("radiance_input_basis");
+    if (it == j.end() || it->is_null()) return RAD_OK;
+    if (!it->is_string()) { *err = path + ": radiance_input_basis is not a string"; return RAD_E_INVAL; }
+    *out = it->get<std::string>();
+    std::string why;
+    if (lora::parse_input_basis(*out, nullptr, &why) < 0) {
+        *err = fmt("adapter '%s': %s", name.c_str(), why.c_str());
+        return RAD_E_UNSUPPORTED;
+    }
+    return RAD_OK;
+}
+
 /* A generator's adapter name: a file stem under --lora-dir, possibly in a subdirectory, never
  * leaving it. */
 bool valid_name(const std::string& n) {
@@ -103,6 +124,41 @@ int Engine::lora_targets() {
         }
         if (cfg_.lora.adapters.empty()) lora_targets_.insert("*");
     }
+    /* The basis the startup adapters' A factors are stored in: every site's GEMM is fed the same
+     * activation, so all of them must declare the same one. */
+    std::string basis_of, keyless;
+    for (const auto& [name, dir] : cfg_.lora.adapters) {
+        if (is_file(dir)) continue;   /* a generator's adapter file declares no targets here */
+        std::string err, b;
+        const int s = read_input_basis(name, dir, &b, &err);
+        if (s < 0) {
+            RAD_ERR("lora: %s", err.c_str());
+            return s;
+        }
+        if (b.empty()) {
+            if (keyless.empty()) keyless = name;
+            continue;
+        }
+        if (!cfg_.lora.input_basis.empty() && cfg_.lora.input_basis != b) {
+            RAD_ERR("lora: adapter '%s' declares \"radiance_input_basis\": \"%s\" and adapter '%s' "
+                    "declares \"%s\"; the sites' GEMMs are fed one activation, so every adapter "
+                    "must declare the same basis", basis_of.c_str(), cfg_.lora.input_basis.c_str(),
+                    name.c_str(), b.c_str());
+            return RAD_E_UNSUPPORTED;
+        }
+        if (cfg_.lora.input_basis.empty()) basis_of = name;
+        cfg_.lora.input_basis = b;
+    }
+    /* An adapter with no key leaves the sites' basis undetermined for it: with one adapter it is
+     * refused at the sites themselves (a weight in a transform basis), but beside one that did
+     * declare the key it would be applied in that basis, silently. */
+    if (!cfg_.lora.input_basis.empty() && !keyless.empty()) {
+        RAD_ERR("lora: adapter '%s' declares \"radiance_input_basis\": \"%s\" and adapter '%s' "
+                "declares none; one activation feeds every site, so an adapter stored in no "
+                "declared basis cannot ride along", basis_of.c_str(), cfg_.lora.input_basis.c_str(),
+                keyless.c_str());
+        return RAD_E_UNSUPPORTED;
+    }
     lora_table_.reset(cfg_.lora.slots(), &lora_epoch_);
     return RAD_OK;
 }
