+void Ctx::observe_issue(rad_op h, const OpPlan& p, const RadParam* params, int n_params,
+                        const RadOperand* opd, const RadTensor* t, int n_opd, int64_t n) {
+    if (!issue_observer_.op) return;
+    RadIssueOperand os[MAX_OPERANDS];
+    const int no = std::min(n_opd, (int)MAX_OPERANDS);
+    for (int i = 0; i < no; ++i) {
+        const RadOperand& o = opd[i];
+        RadIssueOperand& e = os[i];
+        e = RadIssueOperand{};
+        e.kind   = o.kind;
+        e.handle = o.handle;
+        e.data   = t[i].data;
+        e.dtype  = t[i].dtype;
+        e.rank   = (uint8_t)t[i].rank;
+        for (uint32_t d = 0; d < t[i].rank && d < RAD_MAX_RANK; ++d) e.shape[d] = t[i].shape[d];
+        e.offset = o.offset;
+        e.rows   = o.rows;
+        /* The declared shape and name live in the template the issue copied; the template also
+         * holds dim 0 before this issue narrowed it. */
+        const RadTensor* full = nullptr;
+        if (o.kind == RAD_OPK_BUF && o.handle < buf_tmpl_.size()) {
+            full = &buf_tmpl_[o.handle];
+            if (program_ && o.handle < program_->buffers.size())
+                e.name = program_->buffers[o.handle].name.c_str();
+        } else if ((o.kind == RAD_OPK_WEIGHT || o.kind == RAD_OPK_WTAB) &&
+                   o.handle < w_tmpl_.size()) {
+            full = &w_tmpl_[o.handle];
+            if (program_ && o.handle < program_->weights.size())
+                e.name = program_->weights[o.handle].name.c_str();
+        }
+        if (full) {
+            e.rank = (uint8_t)full->rank;
+            for (uint32_t d = 0; d < full->rank && d < RAD_MAX_RANK; ++d) e.shape[d] = full->shape[d];
+            if (o.kind == RAD_OPK_WTAB) {
+                /* The table's dim 0 is the run's length, not a row extent. */
+                e.rows = 0;
+            }
+        }
+        /* A KV operand's offset is its layer, not an element offset. */
+        if (o.kind == RAD_OPK_KV) e.offset = 0;
+        if (o.kind != RAD_OPK_WTAB && rad_tensor_is_contiguous(&t[i]))
+            e.bytes = rad_dtype_bytes(t[i].dtype, rad_tensor_numel(&t[i]));
+        const int role = (p.info && p.info->schema && i < p.info->schema->n_operands)
+                             ? p.info->schema->operands[i].role : RAD_OPD_IN;
+        e.written = (role == RAD_OPD_OUT || role == RAD_OPD_INOUT) ? 1 : 0;
+        e.inout = role == RAD_OPD_INOUT ? 1 : 0;
+    }
+    RadIssueOp ev{};
+    ev.op         = h;
+    ev.name       = (p.info && p.info->schema) ? p.info->schema->op
+                   : (p.info ? p.info->op.c_str() : "?");
+    ev.params     = params;
+    ev.n_params   = n_params;
+    ev.operands   = os;
+    ev.n_operands = no;
+    ev.n          = n;
+    issue_observer_.op(issue_observer_.user, this, &ev);
+}
+
 }  /* namespace rad */
 
