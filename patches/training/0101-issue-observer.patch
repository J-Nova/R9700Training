+/* ================================================================== issue observer */
+/* An optional observer on the context. With none set, issue() and the block brackets cost one
+ * branch each. A tool sets one to read the graph an architecture issues without changing the
+ * architecture; the core never reads what the observer does.
+ *
+ * The core owns the arrays passed to the callbacks: they are valid only for the duration of the
+ * call, and the observer must not issue an op from one. */
+typedef struct RadIssueOperand {
+    uint8_t  kind;         /* RAD_OPK_* */
+    uint32_t handle;       /* rad_buf, rad_weight or rad_kvgroup; 0 for RAW and NONE */
+    void*    data;         /* the pointer the kernel receives; for WTAB the pointer table */
+    int64_t  bytes;        /* bytes at data for this issue; 0 when they are not one span */
+    const char* name;      /* the declared name of a buffer or weight; null otherwise */
+    uint32_t dtype;        /* RadDType the kernel reads; RAD_DT_INVALID when it has none */
+    uint8_t  rank;
+    int64_t  shape[RAD_MAX_RANK]; /* the declared shape, before this issue narrows dim 0 */
+    int64_t  offset;       /* element offset into the buffer or weight, as issued */
+    int64_t  rows;         /* dim 0 extent this issue uses; 0 means the declared extent */
+    uint8_t  written;      /* 1 for RAD_OPD_OUT and RAD_OPD_INOUT, 0 otherwise */
+    uint8_t  inout;        /* 1 for RAD_OPD_INOUT, whose previous value the kernel also reads */
+} RadIssueOperand;
+
+typedef struct RadIssueOp {
+    rad_op          op;         /* the op's handle */
+    const char*     name;       /* the schema's op name */
+    const RadParam* params;     /* the resolved geometry, ranges collapsed */
+    int             n_params;
+    const RadIssueOperand* operands; /* schema order, the trailing absent ones left out */
+    int             n_operands;
+    int64_t         n;          /* the ranged count this issue resolved to */
+} RadIssueOp;
+
+/* `op` is called once per issue, after the op ran, so a consumer that reads operand bytes sees
+ * what it wrote. `block` is called with begin=1 before an architecture block (a layer) issues its
+ * ops and with begin=0 after its last one. `block` is the index the architecture names it by; the
+ * core does not interpret it. An observer must not call rad_issue: the issue path's per-issue
+ * storage does not nest. */
+typedef struct RadIssueObserver {
+    void* user;
+    void (*op)(void* user, RadCtx* c, const RadIssueOp* o);
+    void (*block)(void* user, RadCtx* c, int64_t block, int begin);
+} RadIssueObserver;
+
+/* Install `observer` (copied) and clear it with null. Not thread safe; set it between steps. */
+void rad_set_issue_observer(RadCtx* c, const RadIssueObserver* observer);
+
+/* Called by an architecture around one block of its forward. With no observer set both are one
+ * branch. */
+void rad_block_begin(RadCtx* c, int64_t block);
+void rad_block_end(RadCtx* c, int64_t block);
+
+/* Defined by a runtime that carries the observer above: a tool that records the graph tests this
+ * macro rather than the radiance version, because the hook may reach it as a downstream patch. */
+#define RAD_ISSUE_OBSERVER 1
+
 /* Fail the step with a reason. An architecture block's step() returns void, so this is how it
  * refuses a batch shape it does not serve; the engine stops with `what` in the message. Returns
  * the status it set, so a helper can `return rad_step_fail(...)`. */
